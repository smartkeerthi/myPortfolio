<section class="experiences" id="experiences">
  <div class="experiences-container">
    <div class="title">
      <h2>My experiences</h2>
    </div>
    <div class="experiences-descriptions">
      <div class="experiences-description-container">
        <div class="experiences-description">
          <ul>
            {%- for work in collections.works | reverse -%}
            <li>
              <p class="title">{{ work.data.title }}</p>
              <p class="years">{{ work.data.startDate }} &nbsp; - &nbsp; <span>{{ work.data.endDate }}</span></p>
              <p class="name">{{ work.data.companyName }}</p>
              <p>{{ work.data.description }}</p>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="projects" id="projects">
  <div class="projects-container">
    <h2>My Projects</h2>
    <div class="stacking">
      {%- for project in collections.kkprojects | reverse -%}
      <div class="stacking-card">
        <div class="heading">
          <h3>{{ project.data.title }}</h3>
          <a href={{ project.data.url }} class="link" target="_blank">{{ project.data.linkName }}
            <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd"
              clip-rule="evenodd">
              <path fill="#fff"
                d="M11 21.883l-6.235-7.527-.765.644 7.521 9 7.479-9-.764-.645-6.236 7.529v-21.884h-1v21.883z" />
            </svg></a>
        </div>
        <div class="body">
          <div class="left">{{ project.data.description }}</div>
          <div class="right">
            <img loading="lazy" src={{ project.data.image }} alt={{ project.data.imageAlt }}>
          </div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

